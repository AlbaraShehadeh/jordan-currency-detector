# Copy to `.env` (gitignored) and fill in. Never commit real values.

# Roboflow: only needed for `jcd data pull` (Phase 2). Settings -> Roboflow API in your workspace.
ROBOFLOW_API_KEY=

# Hugging Face: needed to push datasets/models/Space (Phase 2+). https://huggingface.co/settings/tokens
HF_TOKEN=
