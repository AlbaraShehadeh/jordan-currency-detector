# --- ML artifacts: never committed (data & weights live on Hugging Face Hub)
# Anchored to the repo root: an unanchored `data/` would also hide src/jcd/data/ and reports/data/.
# No trailing slash so the iCloud-workaround symlinks (data -> data.nosync) are matched too.
/data
/datasets
/runs
/mlruns
/outputs
/artifacts
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.mp4
*.avi
*.mov

# --- notebooks
.ipynb_checkpoints/

# --- OS / editors
.DS_Store
.idea/
.vscode/

# --- iCloud: Documents/ is synced; *.nosync dirs are excluded (.venv and data are symlinks to them)
*.nosync
